OPENAI_API_KEY=

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_FINAL_BUCKET=
IMAGE_MAX_UPLOAD_BYTES=10485760

# AWS DynamoDB
DYNAMODB_JOBS_TABLE=
DYNAMODB_USAGE_TABLE=
DYNAMODB_SUBMISSION_GUARD_TABLE=

# Submission protection
# Set this private value in the Next.js runtime and configure the trusted proxy
# to inject it as the X-Submission-Proxy-Token request header.
SUBMISSION_GUARD_SECRET=
SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60
ANONYMOUS_SUBMISSION_RATE_LIMIT=3
AUTHENTICATED_SUBMISSION_RATE_LIMIT=10
ANONYMOUS_SUBMISSION_MAX_CONCURRENCY=1
AUTHENTICATED_SUBMISSION_MAX_CONCURRENCY=2
SUBMISSION_CONCURRENCY_LEASE_SECONDS=60

# AWS Cognito
COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
COGNITO_ISSUER=
